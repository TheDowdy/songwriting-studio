    "check:pegs": "node scripts/pegs-check.mjs",
    "check:strum": "node scripts/strum-check.mjs",
    "check:scales": "node scripts/scales-check.mjs",
    "check:chords": "node scripts/chords-check.mjs",
    "check:identify": "node scripts/identify-check.mjs",
    "check:guitars": "node scripts/guitars-check.mjs",
    "check:fallback": "node scripts/fallback-check.mjs",
    "check:deploy": "node scripts/deploy-check.mjs",
    "check:settings": "node scripts/settings-check.mjs",
    "check:a11y": "node scripts/a11y-check.mjs",
